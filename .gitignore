# Build trees: every CMake preset builds under build/<preset> (see CMakePresets.json)
/build/

# Left behind by a rejected in-source configure (CMakeLists.txt refuses it)
/CMakeCache.txt
/CMakeFiles/

# Specification PDFs are freely downloadable and not redistributed here
/docs/reference/*.pdf

# macOS
.DS_Store

# Python bytecode from the model checkers (tools/modelcheck, docs/design/evidence)
__pycache__/

# Public OpenSHMEM code bases, fetched for reading only (tools/corpus/fetch.sh).
# Never built, never copied into the repository.
/corpus/

# Scratch directory for temporary files
scratch/
