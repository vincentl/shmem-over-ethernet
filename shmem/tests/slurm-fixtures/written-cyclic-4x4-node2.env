# written from the documentation, provisional: srun -N4 --ntasks-per-node=4
# --distribution=cyclic on pi-[001-004], rank 6 on the third node, whose ranks
# are 2, 6, 10 and 14 - not contiguous, which only SLURM_GTIDS says (§6.1).
# expect: launcher=SLURM_ rank=6 size=16 node=2 nodes=4 local=1/4 gtids=2,6,10,14 job=1234 step=3 hosts=pi-[001-004]
SLURM_JOB_ID=1234
SLURM_STEP_ID=3
SLURM_PROCID=6
SLURM_LOCALID=1
SLURM_NODEID=2
SLURM_STEP_NUM_TASKS=16
SLURM_STEP_NUM_NODES=4
SLURM_STEP_NODELIST=pi-[001-004]
SLURM_STEP_TASKS_PER_NODE=4(x4)
SLURM_GTIDS=2,6,10,14
SLURM_DISTRIBUTION=cyclic
