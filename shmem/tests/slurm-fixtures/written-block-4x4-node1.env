# written from the documentation, provisional: srun -N4 --ntasks-per-node=4 on
# pi-[001-004], block distribution (the default), rank 5 on the second node.
# expect: launcher=SLURM_ rank=5 size=16 node=1 nodes=4 local=1/4 gtids=4,5,6,7 job=1234 step=0 hosts=pi-[001-004]
SLURM_JOB_ID=1234
SLURM_STEP_ID=0
SLURM_PROCID=5
SLURM_LOCALID=1
SLURM_NODEID=1
SLURM_STEP_NUM_TASKS=16
SLURM_STEP_NUM_NODES=4
SLURM_STEP_NODELIST=pi-[001-004]
SLURM_STEP_TASKS_PER_NODE=4(x4)
SLURM_GTIDS=4,5,6,7
SLURM_NODELIST=pi-[001-004]
SLURM_JOB_NODELIST=pi-[001-004]
