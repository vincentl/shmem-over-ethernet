# osoe-launch's names inside a Slurm allocation - a test run under salloc on the
# cluster: OSOE_PROCID decides, and every name is read with OSOE_, none mixed.
# expect: launcher=OSOE_ rank=1 size=2 node=0 nodes=1 local=1/2 gtids=0,1 job=999 step=0 hosts=127.0.0.1
OSOE_PROCID=1
OSOE_LOCALID=1
OSOE_NODEID=0
OSOE_STEP_NUM_TASKS=2
OSOE_STEP_NUM_NODES=1
OSOE_GTIDS=0,1
OSOE_JOB_ID=999
OSOE_STEP_ID=0
OSOE_STEP_NODELIST=127.0.0.1
SLURM_JOB_ID=1234
SLURM_STEP_ID=0
SLURM_PROCID=5
SLURM_LOCALID=1
SLURM_NODEID=1
SLURM_STEP_NUM_TASKS=16
SLURM_STEP_NUM_NODES=4
SLURM_STEP_NODELIST=pi-[001-004]
SLURM_GTIDS=4,5,6,7
