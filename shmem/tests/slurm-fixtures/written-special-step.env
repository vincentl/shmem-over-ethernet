# written, not captured: a task of one of Slurm's own steps - an interactive
# allocation's, whose step id is 0xfffffffa - which a program must not take for
# a step of its own; refused until such a step is captured (§6.1, §8.2).
# expect-fatal: SLURM_STEP_ID=4294967290 is one of Slurm's own steps
SLURM_JOB_ID=1234
SLURM_STEP_ID=4294967290
SLURM_PROCID=0
SLURM_LOCALID=0
SLURM_NODEID=0
SLURM_STEP_NUM_TASKS=1
SLURM_STEP_NUM_NODES=1
SLURM_STEP_NODELIST=pi-001
SLURM_GTIDS=0
