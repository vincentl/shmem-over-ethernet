# U2, halo exchange: PRK 2D star stencil.
# Bulk put of each ghost strip, one fence, a flag increment per neighbour, and a
# wait on the local flag for every neighbour's increments.
trace     U2-prk-stencil
workload  U2
source    prk 25051e46e54cd9dad33af1cdfbe66484131a603a
loop      SHMEM/Stencil/stencil.c:414-500  one stencil iteration
threads   1
build     SPLITFENCE=0 (SHMEM/Stencil/Makefile:30-31); with 1, each put is followed by its own fence and increment
build     DOUBLE=1 (SHMEM/Stencil/Makefile:21); DTYPE is double (stencil.c:66)
param     NBR     2..4   # grid neighbours of this PE (count_case, stencil.c:126,241-244); not periodic
param     RADIUS  2      # SHMEM/Stencil/Makefile:42
param     W       data   # tile width (top and bottom strips) or height (right and left strips)
# The first iteration is a warm-up; a barrier at :418 starts the timer on iteration 1.

# Order: top, bottom, right, left, each only if that neighbour exists.
# Destination buffer alternates between two per iteration (sw = iter % 2).
repeat NBR  one strip per existing neighbour
  call  shmem_putmem  1  RADIUS*W*8  neighbour  default  SHMEM/Stencil/stencil.c:430  # also :440, :451, :462
end
call  shmem_fence  -  -  -  default  SHMEM/Stencil/stencil.c:470
repeat NBR  same order
  call  shmem_int_inc  4  1  neighbour  default  SHMEM/Stencil/stencil.c:471  # :471-474; iterflag[sw] on the neighbour
end
# SHMEM_CMP_EQ against NBR*(iter/2+1): all of this PE's neighbours' increments.
call  shmem_int_wait_until  4  1  self  -  SHMEM/Stencil/stencil.c:477
