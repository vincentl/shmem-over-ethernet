# U4, put-with-signal: PRK Synch_p2p, a pipeline of PEs in a chain.
# Per row, the left PE puts one boundary value, fences, then sets a flag word on
# the right PE; the right PE waits on that flag before using the value. This is
# put-then-signal-then-wait by hand: the signal is a SET, not an ADD, and the
# value waited for alternates between 1 and 0 from one iteration to the next
# (true = (iter+1)%2 at :252).
trace     U4-prk-p2p
workload  U4
source    prk 25051e46e54cd9dad33af1cdfbe66484131a603a
loop      SHMEM/Synch_p2p/p2p.c:248-320  one pipeline sweep over all rows
threads   1
build     SYNCHRONOUS=0 (SHMEM/Synch_p2p/Makefile:30-31); with 1, each row adds a reverse handshake: a second wait and put per row
param     N  data   # rows of the grid (n, p2p.c:136); the row loop runs N-1 times
# Chain order is PE number; root is the last PE (p2p.c:108). Not periodic,
# except for the corner value the last PE returns to PE 0 at the end.
# A barrier at :256 starts the timer on iteration 1.

role first  PE 0
  # Waits for the corner value from the previous sweep.
  call  shmem_int_wait_until  4  1  self  -  SHMEM/Synch_p2p/p2p.c:262
end

repeat N-1  one row j
  role receiver  every PE except PE 0
    call  shmem_int_wait_until  4  1  self  -  SHMEM/Synch_p2p/p2p.c:277  # flag_left[j]; a different word per row
  end
  role sender  every PE except the last
    call  shmem_double_p  8  1  neighbour  default  SHMEM/Synch_p2p/p2p.c:296  # dst[j] on the right neighbour
    call  shmem_fence     -  -  -          default  SHMEM/Synch_p2p/p2p.c:297
    call  shmem_int_p     4  1  neighbour  default  SHMEM/Synch_p2p/p2p.c:299  # flag_left[j] on the right neighbour
  end
end

role last  the last PE, when there is more than one
  call  shmem_double_p  8  1  neighbour  default  SHMEM/Synch_p2p/p2p.c:308  # dst[0] on PE 0
  call  shmem_fence     -  -  -          default  SHMEM/Synch_p2p/p2p.c:309
  call  shmem_int_p     4  1  neighbour  default  SHMEM/Synch_p2p/p2p.c:316  # flag_left[0] on PE 0
end
