+            osoe_fatal("cannot register %u files: %s", wire_count, strerror(-e));
+        free(fds);
+        r->fixed_files = true;
+    }
     r->buffer_ring = io_uring_setup_buf_ring(&r->uring, buffer_count, 0, 0, &e);
