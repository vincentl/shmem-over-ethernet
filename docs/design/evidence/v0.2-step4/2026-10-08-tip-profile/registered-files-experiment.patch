+    /* EXPERIMENT, not for merging: the wires as registered files. */
+    const char *fixed = getenv("OSOE_EXPERIMENT_FIXED_FILES");
+    if (fixed && strcmp(fixed, "1") == 0 && wire_count > 0) {
+        int *fds = calloc(wire_count, sizeof *fds);
+        for (uint32_t i = 0; i < wire_count; i++)
+            fds[i] = wires[i].fd;
+        e = io_uring_register_files(&r->uring, fds, wire_count);
